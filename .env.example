# --- thay-auth runtime config (kept out of git) ---
# Copy from .env.example and fill the secrets.

# Public bind port
PORT=3749

# --- PocketBase (the live hcgi/platform instance) ---
PB_URL=https://thaypley.com/hcgi/platform
PB_ADMIN_EMAIL=admin@thaypley.com
PB_ADMIN_PASSWORD=__fill__
PB_DATA_PATH=/pb_data/data.db

# --- Bypass the broken PB admin POST /api/collections/users/records ---
# When 1, /auth/signup writes the user row directly to PB's sqlite
# (requires the PB data dir be bind-mounted at /pb_data, see docker-compose.yml).
DIRECT_SQL_USERS=1

# --- JWT secret for device tokens (signs /devices/pair tokens) ---
THAY_AUTH_JWT_SECRET=__fill__

# --- CORS ---
CORS_ORIGINS=https://thaypley.com,https://auth.thaypley.com,https://api.thaypley.com,https://fam.thaypley.com,https://werk.thaypley.com,http://localhost:5173,http://localhost:3749,http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost

# --- Email (SMTP for verification + password reset) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=__fill__
SMTP_FROM=noreply@thaypley.com

# --- Invite defaults ---
INVITE_CODE_PREFIX=TP
INVITE_DEFAULT_MAX_USES=1

# --- Logging ---
LOG_LEVEL=info

# --- Performance / scaling knobs (defaults shown) ---

# Reverse proxy trust. Default 'loopback' trusts only the local nginx hop —
# client-forged X-Forwarded-For can no longer spoof the rate-limiter key.
# Set to 1 only if nginx is NOT on the same host.
# TRUST_PROXY=loopback

# Shared rate limiting across replicas (empty = per-instance in-memory).
# REDIS_URL=redis://127.0.0.1:6379

# Cache sizes (per 256MB container budget)
# TOKEN_CACHE_MAX=20000        # L1 verified-token cache (slim records)
# REVOCATION_CACHE_MAX=20000   # session revocation cache
# REVOCATION_CACHE_TTL_MS=60000
# PROFILE_CACHE_MAX=10000      # /me + /profile per-user cache
# DEVICE_CACHE_MAX=50000       # /devices/verify cache
# USER_CACHE_MAX=2000          # email/username lookup cache

# Session-revocation failure policy: 'closed' (secure default) or 'open'
# (keep serving during PB outages; revoked sessions usable up to cache TTL).
# REVOCATION_FAIL_POLICY=closed

# PB concurrency caps
# PB_VERIFY_CONCURRENCY=32     # max concurrent authRefresh calls to PB

# bcrypt worker pool (signup hashing runs off the event loop).
# 0 = auto: min(max(2, cores-1), 4). Queue overflow falls back inline.
# BCRYPT_WORKERS=0
# BCRYPT_MAX_QUEUE=64

# --- avatar sync ---
# Comma-separated HTTPS endpoints that receive a signed webhook when any
# user changes their avatar (thaypley.com or auth.thaypley.com). The
# PRIMARY mechanism is the ?v=avatarVersion cache-bust on the canonical
# avatar URL; these push endpoints let apps invalidate in-memory caches
# instantly instead of waiting for the next profile fetch.
# AVATAR_SYNC_WEBHOOKS=https://tunes.thaypley.com/api/avatar-sync,https://jot.thaypley.com/api/avatar-sync

# --- billing / thay-sub ---
# Stripe keys (native-fetch, no SDK). Empty keys = mock mode: checkout returns
# a deterministic in-app "simulated" URL so dev/tests exercise the full contract
# without payment credentials. Live mode enables checkout/portal/webhook.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional per-tier price IDs (defaults are placeholders — set for live):
# STRIPE_PRICE_CORE=price_...
# STRIPE_PRICE_PLUS=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# Public origin of this deployment (used for checkout return/cancel URLs).
# APP_BASE_URL=https://auth.thaypley.com
# Health probe staleness threshold.
# PB_STALE_MS=60000

# --- metrics ---
# GET /metrics exposes Prometheus-format metrics (no auth; protect at the LB).
